<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <RebuildWithResources Condition="'$(RebuildWithResources)' == ''">false</RebuildWithResources>
  </PropertyGroup>

  <Import Condition="'$(RebuildWithResources)' == 'true'" Project="..\MonoGame.Library.Content.Builder\BuildContent.targets" />
</Project>