<Project>
  <Target Name="BuildContent" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ContentOutput>$(ProjectDir)$(OutputPath)</ContentOutput>
      <ContentTemp>$(ProjectDir)$(IntermediateOutputPath)</ContentTemp>
      <ContentArgs>build -p $(MonoGamePlatform) -s MonoGame.Library.Content.Builder/Assets -o $(ContentOutput) -i $(ContentTemp)</ContentArgs>
      <ContentCommand>$(MSBuildThisFileDirectory)bin\$(Configuration)\MonoGame.Library.Content.Builder</ContentCommand>
    </PropertyGroup>
    <Exec Command="$(ContentCommand) $(ContentArgs)" WorkingDirectory="$(MSBuildThisFileDirectory)..\" CustomErrorRegularExpression="\[E\] .+" CustomWarningRegularExpression="\[W\] .+" />
  </Target>
  <Target Name="AddGeneratedContentAssets" AfterTargets="BuildContent">
    <ItemGroup>
      <Assets Include="$(ProjectDir)$(OutputPath)Content\**\*" />
      <EmbeddedResource Include="@(Assets)" LogicalName="%(Filename)%(Extension)"/>
    </ItemGroup>
  </Target>
</Project>
